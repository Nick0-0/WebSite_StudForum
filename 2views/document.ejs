<link rel="stylesheet" href="styles/document-style.css" type="text/css">

<div class="doc-action-page">
    <div class="docs-action-bar">
        <div class="search-box">
            <input type="text" id="doc-search" placeholder="Поиск документов" oninput="filterDocuments()">
        </div>

        <% if (role === 'student') { %>
            <button class="btn-upload-trigger" onclick="document.getElementById('upload-modal').style.display='flex'">
                Добавить собственный файл
            </button>
        <% } %>
    </div>

    <main class="documents-grid" id="docs-grid">
        <% if (documents && documents.length > 0) { %>
            <% documents.forEach(doc => { %>
                <%
                    let displayName = 'Документ #' + doc.id;
                    if (doc.type_of_document && doc.type_of_document.includes(':')) {
                        const parts = doc.type_of_document.split(':');
                        displayName = parts.slice(1).join(':');
                    }
                %>

                <div class="doc-card-wrapper" id="global-doc-block-<%= doc.id %>">
                    <a href="/document/download/<%= doc.id %>" class="doc-card" data-title="<%= doc.first_name %> <%= doc.last_name %>">
                        <div class="doc-icon-wrapper">
                            <img src="/media/file-icon.png" alt="File" class="doc-icon">
                        </div>
                        <div class="doc-info">
                            <span class="doc-name"><%= displayName %></span>
                            <p class="doc-author">Автор: <%= doc.first_name %> <%= doc.last_name %></p>
                            
                            <% if (doc.topic_name) { %>
                                <p class="doc-topic-link">Тема: <span style="color: #296a4a; font-weight: bold;"><%= doc.topic_name %></span></p>
                            <% } %>
                        </div>
                    </a>

                    <div class="doc-card-actions-panel">
                    <% if (role === 'student') { %>
                        <button class="btn-report-doc" onclick="reportDocument('<%= doc.id %>', '<%= displayName %>')"
                            title="Пожаловаться на файл">
                                Пожаловаться
                            </button>
                    <% } %>
                    <% if (role === 'admin') { %>
                            <button class="btn-admin-delete-doc" onclick="adminDeleteDocument('<%= doc.id %>')">
                                Удалить файл
                            </button>
                    <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p class="empty-text">Документов пока нет. Станьте первым, кто загрузит учебные материалы!</p>
        <% } %>
    </main>
</div>

<div id="upload-modal" class="modal">
    <div class="modal-content">
        <h3>Загрузка учебного материала</h3>
        <form action="/document/upload" method="POST" enctype="multipart/form-data" class="upload-form">
            
            <div class="file-drop-zone">
                <input type="file" name="doc" id="file-input" required>
                <label for="file-input">Нажмите для выбора файла (до 2 ГБ)</label>
            </div>

            <div class="select-field">
                <label for="doc-type">Приватность:</label>
                <select name="type_of_document" id="doc-type" required>
                    <option value="public">Публичный (виден всем во вкладке)</option>
                    <option value="private">Приватный (виден только мне в профиле)</option>
                </select>
            </div>

            <div class="input-field">
                <label for="document-topic">Привязать к теме на форуме (необязательно):</label>
                <select name="topic_id" id="document-topic">
                    <option value="">-- Без привязки к теме --</option>
                    <% if (typeof topics !== 'undefined' && topics.length > 0) { %>
                        <% topics.forEach(topic => { %>
                            <option value="<%= topic.id %>"><%= topic.name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div class="modal-buttons">
                <button type="submit" class="btn-submit">Загрузить</button>
                <button type="button" class="btn-cancel" onclick="document.getElementById('upload-modal').style.display='none'">
                    Отмена
                </button>
            </div>
        </form>
    </div>
</div>

<div id="complaint-modal" class="modal">
    <div class="modal-content">
        <h3>Жалоба на учебный материал</h3>
        <p id="complaint-doc-title" style="font-weight: bold; color: #333;
        text-align: center; margin-bottom: 15px;"></p>

        <form id="complaint-form" class="upload-form">
            <input type="hidden" id="complaint-doc-id">

            <div class="select-field">
                <label for="complaint-reason">Укажите причину:</label>
                <select id="complaint-reason" required>
                    <option value="" disabled>-- Выберите причину --</option>
                    <option value="Файл поврежден / не открывается">
                        Файл поврежден / не открывается
                    </option>
                    <option value="Недостоверная / ложная информация">
                        Недостоверная / ложная информация
                    </option>
                    <option value="Материал содержит плагиат">
                        Материал содержит плагиат
                    </option>
                    <option value="Спам или вредоносное ПО">
                        Спам или вредоносное ПО
                    </option>
                    <option value="Другое">
                        Другое
                    </option>
                </select>
            </div>

            <div class="modal-buttons">
                <button type="submit" class="btn-submit">Отправить жалобу</button>
                <button type="button" class="btn-cancel"
                onclick="document.getElementById('complaint-modal').style.display = 'none'">Отмена</button>
            </div>
        </form>
    </div>
</div>

<script>
    function filterDocuments() {
        const query = document.getElementById('doc-search').value.toLowerCase();
        const cards = document.querySelectorAll('.doc-card');

        cards.forEach(card => {
            const author = card.getAttribute('data-title').toLowerCase();
            const docId = card.querySelector('.doc-name').textContent.toLowerCase();

            if (author.includes(query) || docId.includes(query)) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>