<link rel="stylesheet" href="styles/calendar-style.css" type="text/css">

<a href="/" class="back-btn">Вернуться на главную</a>

<div class="calendar-container">
    <div class="calendar-main">
        <div class="calendar-header">
            <h2>Название месяца</h2>
        </div>

        <div class="calendar-grid">
            <div class="day-name">Пн</div>
            <div class="day-name">Вт</div>
            <div class="day-name">Ср</div>
            <div class="day-name">Чт</div>
            <div class="day-name">Пт</div>
            <div class="day-name">Сб</div>
            <div class="day-name">Вс</div>
            
            <!-- creating empty cells for the offset -->
            <!-- <% const startOffset = 4; %> -->
            
            <% for(let i = 1; i <= 31; i++) { %>
                <% 
                const dayStr = i < 10 ? '0' + i : String(i);
                const dayEvents = events.filter(e => e.start_date && e.start_date.startsWith(dayStr));
                %>
                <div class="calendar-day <%= dayEvents.length > 0 ? 'has-event' : '' %>">
                    <span class="day-number"><%= i %></span>
                    <% if (dayEvents.length > 0) { %>
                        <div class="day-events-container">
                            <% dayEvents.forEach(event => { %>
                                <div class="event-dot" 
                                     title="<%= event.name %> (<%= event.description || 'Без описания' %>)">
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
    
    <aside class="calendar-sidebar">
        <div class="info-card">
            <h3>Университетские события</h3>
            <p>Следите за актуальными мероприятиями нашего вуза</p>
            <button class="btn-suggest" onclick="document.getElementById('suggest-modal').style.display='flex'">
                Предложить событие
            </button>
        </div>
    </aside>
</div>

<div id="suggest-modal" class="modal">
    <div class="modal-content">
        <h3>Предложить событие</h3>
        <form action="/calendar/suggest" method="POST" class="upload-form" id="suggest-event-form">

            <div class="input-field">
                <label for="event-name">Название события:</label>
                <input type="text" name="name" id="event-name" 
                placeholder="Например: День Открытых Дверей" maxlength="100" required>
            </div>
            <div class="input-field">
                <label for="event-start">Дата и время начала:</label>
                <input type="datetime-local" name="start_date" id="event-start" required>
            </div>
            <div class="input-field">
                <label for="event-end">Дата и время окончания:</label>
                <input type="datetime-local" name="end_date" id="event-end" required>
            </div>
            <div class="input-field">
                <label for="event-desc">Описание события (до 512 симв.):</label>
                <textarea name="description" id="event-desc" placeholder="Кратко расскажите о мероприятии..." maxlength="512" rows="4"></textarea>
            </div>

            <div class="modal-buttons">
                <button type="submit" class="btn-submit">Отправить</button>
                <button type="button" class="btn-cancel" onclick="document.getElementById('suggest-modal').style.display='none'">Отменить</button>
            </div>
        </form>
    </div>
</div>