<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="descrition" content="Сайт студенческого форума - демонстрация полученных навыков веб-верстки в ходе обучения.">
    <link rel="icon" href="./media/favicon.svg" type="image/svg+html">
    <link rel="stylesheet" href="styles/index-style.css" type="text/css">
    <title>StudForum</title>
</head>
<body>
    <header>
        <a href="/" class="icon">
            <img src="./media/favicon.svg" alt="icon.png">
            <p>студфорум</p>
        </a>
        <nav class="navigation-bar">
            <a href="/" class="nav-link">Главная</a>
            <a href="/forum" class="nav-link">Форум</a>
            <a href="/documents" class="nav-link">Документы</a>
            <a href="/calendar" class="nav-link">Календарь</a>
        </nav>
        <div class="auth-zone">
            <% if (user) { %>
                <a href="/profile" class="profile-btn">Профиль</a>
            <% } else { %>
                <a href="/auth" class="profile-btn">Вход</a>
            <% } %>
        </div>
    </header>

    <main id="main">
        <%- body %>
    </main>

    <footer>
        <div class="footer-info">
            <p class="copyright">&copy;studforum 2026</p>
            <a title="+7-(000)-000-00-00" href="tel:+70000000000">наш телефон</a>
            <a title="studfor-hotline@nomail.qwerty" href="mailto:studfor-hotline@nomail.qwerty">наша почта</a>
        </div>
        <div class="footer-social">
            <!-- <a><img name="social network" alt="social network"></a> -->
            <a title="our telegram" href="https://t.me/Chtotihocheshotmenya_yoKlmNo">
                <img class="social-icon" alt="telegram" src="/media/telegram.png">
            </a>
            <a title="our vkontakte" href="https://vk.com/pechka_nedorogo">
                <img class="social-icon" alt="vkontakte" src="/media/vkontakte.png">
            </a>
        </div>
    </footer>

    <script src="JS-scripts/main.js"></script>
</body>
</html>