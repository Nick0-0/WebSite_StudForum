<link rel="stylesheet" href="styles/profile-style.css" type="text/css">

<div class="profile-container">
    <aside class="profile-sidebar">
        <nav class="sidebar-menu">
            <a href="/" class="sidebar-link">На главную</a>
            
            <% if (role === 'admin') { %>
                <button class="sidebar-tab active" onclick="switchTab('settings')">
                    Настройки профиля
                </button>
                <button class="sidebar-tab" onclick="switchTab('complaints')">
                    Жалобы
                </button>
                <button class="sidebar-tab" onclick="switchTab('pending')">
                    Предложенные события
                </button>
                <button class="sidebar-tab" onclick="switchTab('news')">
                    Опубликовать новость
                </button>
            <% } else { %>
                <button class="sidebar-tab active" onclick="switchTab('settings')">
                    Настройки профиля
                </button>
                <button class="sidebar-tab" onclick="switchTab('documents')">
                    Мои документы
                </button>
                <button class="sidebar-tab" onclick="switchTab('notes')">
                    Мои заметки
                </button>
            <% } %>

            <a href="/auth/logout" class="sidebar-link logout-btn">Выйти из профиля</a>
        </nav>
    </aside>

    <main class="profile-content">
        <section id="tab-settings" class="tab-content active">
            <form action="/profile/update" method="POST" class="profile-form" enctype="multipart/form-data">
                <div class="profile-header-block">
                    <div class="avatar-container">
                        <% if (user.photo) { %>
                            <img alt="avatar" src="data:image/jpeg;base64, <%= user.photo.toString('base64') %>">
                        <%} else { %>
                            <% if (role === 'student') { %>
                                <img alt="avatar" src="media/avatar-placeholder.png">
                            <% } else { %>
                                <img alt="avatar" src="media/admin-placeholder.png">
                            <% } %>
                        <% } %>

                        <input type="file" name="photo" id="avatar-input" accept="image/*">
                    </div>

                    <div class="user-meta">
                        <h2><%= user.first_name %> <%= user.last_name %></h2>
                        <p class="user-role"><%= role === 'admin' ? 'Администратор' : 'Студент' %></p>

                        <% if (role === 'student') { %>
                            <div class="student-info-row">
                                <span><strong>Курс:</strong> <%= user.course %></span>
                                <span><strong>Факультет:</strong> <%= user.faculty %></span>
                                <span><strong>Группа:</strong> <%= user.group_number %></span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="profile-inputs-grid">
                    <div class="input-field">
                        <label>Email</label>
                        <input type="email" name="email" value="<%= user.email %>" maxlength="64" required>
                    </div>
                    <div class="input-field">
                        <label>Телефон</label>
                        <input type="tel" name="phone_number" value="<%= user.phone_number %>" placeholder="+7 (ЦЦЦ) ЦЦЦ-ЦЦ-ЦЦ" required>
                    </div>

                    <% if (role === 'student') { %>
                        <div class="input-field">
                            <label>Описание профиля (до 512 символов)</label>
                            <textarea name="description" maxlength="512" rows="4" placeholder="Обо мне..."><%= user.description %></textarea>
                        </div>
                    <% } %>
                </div>

                <button type="submit" class="btn-save">Сохранить</button>
            </form>
        </section>

        <% if (role === 'student') { %>
            <section id="tab-documents" class="tab-content">
                <h3>Мои загруженные документы</h3>
                <div id="my-documents-list">
                    <p class="loading-text">Загрузка документов...</p>
                </div>
            </section>

            <section id="tab-notes" class="tab-content">
                <div class="notes-header-zone">
                    <h3>Мои личные заметки</h3>
                    <button class="btn-add-note-trigger" onclick="toggleNoteForm()">
                        + Добавить заметку
                    </button>
                </div>

                <div id="quick-note-form-block" class="quick-note-form-container" style="display: none;">
                    <form id="add-note-form" class="note-ajax-form">
                        <textarea name="description" id="note-text-input" placeholder="Введите текст заметки..." maxlength="1000" required rows="3"></textarea>
                        <div class="note-form-buttons">
                            <button type="submit" class="btn-save-note">Сохранить</button>
                            <button type="button" class="btn-cancel-note" onclick="toggleNoteForm()">Отмена</button>
                        </div>
                    </form>
                </div>

                <div id="my-notes-list">
                    <p class="loading-text">Загрузка заметок...</p>
                </div>
            </section>
        <% } else { %>
            <section id="tab-complaints" class="tab-content">
                <h3>Модерация: жалобы от пользователей</h3>
                <p>Список актуальных жалоб форума</p>
            </section>

            <section id="tab-pending" class="tab-content">
                <h3>Модерация: предложенные события календаря</h3>
                <div id="admin-pending-list">

                </div>
            </section>

            <section id="tab-news" class="tab-content">
                <h3>Публикация общеуниверситетских новостей</h3>
                <form action="/admin/post-news" method="POST" class="auth-form">
                    <input type="text" name="title" placeholder="Заголовок новости" required>
                    <textarea name="content" placeholder="Текст новости" rows="6" required></textarea>
                    <button type="submit" class="btn-save">Опубликовать</button>
                </form>
            </section>
        <% } %>
    </main>
</div>

<script>
    function switchTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
        document.querySelectorAll('.sidebar-tab').forEach(btn => btn.classList.remove('active'));

        document.getElementById('tab-' + tabName).classList.add('active');
        event.currentTarget.classList.add('active');
    }
</script>